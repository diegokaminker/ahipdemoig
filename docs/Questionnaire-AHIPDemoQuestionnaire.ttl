# - resource -------------------------------------------------------------------

<http://ahip.org/demographics/Questionnaire/AHIPDemoQuestionnaire> a fhir:Questionnaire ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "AHIPDemoQuestionnaire"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "extensions" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Questionnaire AHIPDemoQuestionnaire</b></p><a name=\"AHIPDemoQuestionnaire\"> </a><a name=\"hcAHIPDemoQuestionnaire\"> </a><table border=\"1\" cellpadding=\"0\" cellspacing=\"0\" class=\"xhtTableBorder1\"><tr class=\"xhtRowBorder2\"><th scope=\"col\" style=\"\" class=\"hierarchy xhtCellBorder1\"><a href=\"https://hl7.org/fhir/R4/formats.html#table\" title=\"The linkID for the item\">LinkID</a></th><th scope=\"col\" style=\"\" class=\"hierarchy xhtCellBorder1\"><a href=\"https://hl7.org/fhir/R4/formats.html#table\" title=\"Text for the item\">Text</a></th><th scope=\"col\" style=\"\" class=\"hierarchy xhtCellBorder1\"><a href=\"https://hl7.org/fhir/R4/formats.html#table\" title=\"Minimum and Maximum # of times the item can appear in the instance\">Cardinality</a></th><th scope=\"col\" style=\"\" class=\"hierarchy xhtCellBorder1\"><a href=\"https://hl7.org/fhir/R4/formats.html#table\" title=\"The type of the item\">Type</a></th><th scope=\"col\" style=\"\" class=\"hierarchy xhtCellBorder1\"><a href=\"https://hl7.org/fhir/R4/formats.html#table\" title=\"Additional information about the item\">Description &amp; Constraints</a><span style=\"float: right\"><a href=\"https://hl7.org/fhir/R4/formats.html#table\" title=\"Legend for this format\"><img src=\"data:image/png;base64,\" alt=\"doco\" style=\"background-color: inherit\"/></a></span></th></tr><tr class=\"xhtRowBorder1 xhtRowEven\"><td style=\"background-image: url(tbl_bck1.png)\" class=\"hierarchy xhtCellBorder1 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon_q_root.gif\" alt=\"\" style=\"background-color: white; background-color: inherit\" title=\"QuestionnaireRoot\" class=\"hierarchy\"/> AHIP-DEMOGRAPHIC-QUESTIONNAIRE</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">DRAFT QUESTIONNAIRE FOR AHIP - DRAFT VERSION FOR DISCUSSION ONLY</td><td style=\"\" class=\"hierarchy xhtCellBorder1\"/><td style=\"\" class=\"hierarchy xhtCellBorder1\">Questionnaire</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">http://ahip.org/demographics/Questionnaire/AHIPDemoQuestionnaire#0.1.0</td></tr>#xD;\n<tr class=\"xhtRowBorder1 xhtRowOdd\"><td style=\"background-image: url(tbl_bck11.png)\" id=\"item.RAE\" class=\"hierarchy xhtCellBorder1 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon-q-group.png\" alt=\"\" style=\"background-color: #F7F7F7; background-color: inherit\" title=\"group\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">AHIP-DEMOGRAPHIC-QUESTIONNAIRE / </span>RAE</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Race &amp; Ethnicity Section</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">1..1</td><td style=\"\" class=\"hierarchy xhtCellBorder1\"><a href=\"https://hl7.org/fhir/R4/codesystem-item-type.html#item-type-group\">group</a></td><td style=\"\" class=\"hierarchy xhtCellBorder1\"/></tr>#xD;\n<tr class=\"xhtRowBorder1 xhtRowEven\"><td style=\"background-image: url(tbl_bck110.png)\" id=\"item.RAE-1.1\" class=\"hierarchy xhtCellBorder1 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vline.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon-q-coding.png\" alt=\"\" style=\"background-color: white; background-color: inherit\" title=\"coding\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">AHIP-DEMOGRAPHIC-QUESTIONNAIRE / RAE / </span>RAE-1.1</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Please tell us your background. Check all that apply. (If your background is not listed, please let us know by writing on the blank line)</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">1..*</td><td style=\"\" class=\"hierarchy xhtCellBorder1\"><a href=\"https://hl7.org/fhir/R4/codesystem-item-type.html#item-type-choice\">choice</a></td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Value Set: <a href=\"ValueSet-ahip-race-category.html\">AHIP Race and Ethnicity Categories</a></td></tr>#xD;\n<tr class=\"xhtRowBorder1 xhtRowOdd\"><td style=\"background-image: url(tbl_bck110.png)\" id=\"item.RAE-1.2\" class=\"hierarchy xhtCellBorder1 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vline.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon-q-coding.png\" alt=\"\" style=\"background-color: #F7F7F7; background-color: inherit\" title=\"coding\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">AHIP-DEMOGRAPHIC-QUESTIONNAIRE / RAE / </span>RAE-1.2</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Please tell us your background. Check all that apply</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">1..*</td><td style=\"\" class=\"hierarchy xhtCellBorder1\"><a href=\"https://hl7.org/fhir/R4/codesystem-item-type.html#item-type-open-choice\">open-choice</a></td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Enable When: <span><a href=\"#item.RAE-1.1\">RAE-1.1</a> = American Indian or Alaska Native (CDC Race and Ethnicity#1002-5)</span><br/>Value Set: <a href=\"ValueSet-ahip-background-native-american-category.html\">AHIP Native American Background Categories</a></td></tr>#xD;\n<tr class=\"xhtRowBorder1 xhtRowEven\"><td style=\"background-image: url(tbl_bck110.png)\" id=\"item.RAE-1.2-AAPI\" class=\"hierarchy xhtCellBorder1 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vline.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon-q-coding.png\" alt=\"\" style=\"background-color: white; background-color: inherit\" title=\"coding\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">AHIP-DEMOGRAPHIC-QUESTIONNAIRE / RAE / </span>RAE-1.2-AAPI</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Please tell us your background. Check all that apply</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">1..*</td><td style=\"\" class=\"hierarchy xhtCellBorder1\"><a href=\"https://hl7.org/fhir/R4/codesystem-item-type.html#item-type-open-choice\">open-choice</a></td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Enable When: <span><a href=\"#item.RAE-1.1\">RAE-1.1</a> = Asian (CDC Race and Ethnicity#2028-9)</span><br/>Value Set: <a href=\"ValueSet-ahip-background-asian-category.html\">AHIP Asian Background Categories</a></td></tr>#xD;\n<tr class=\"xhtRowBorder1 xhtRowOdd\"><td style=\"background-image: url(tbl_bck110.png)\" id=\"item.RAE1.2-BAOAA\" class=\"hierarchy xhtCellBorder1 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vline.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon-q-coding.png\" alt=\"\" style=\"background-color: #F7F7F7; background-color: inherit\" title=\"coding\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">AHIP-DEMOGRAPHIC-QUESTIONNAIRE / RAE / </span>RAE1.2-BAOAA</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Please tell us your background. Check all that apply</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">1..*</td><td style=\"\" class=\"hierarchy xhtCellBorder1\"><a href=\"https://hl7.org/fhir/R4/codesystem-item-type.html#item-type-open-choice\">open-choice</a></td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Enable When: <span><a href=\"#item.RAE-1.1\">RAE-1.1</a> = Black or African American (CDC Race and Ethnicity#2054-5)</span><br/>Value Set: <a href=\"ValueSet-ahip-background-black-category.html\">AHIP Black Background Categories</a></td></tr>#xD;\n<tr class=\"xhtRowBorder1 xhtRowEven\"><td style=\"background-image: url(tbl_bck110.png)\" id=\"item.RAE1.2-HOL\" class=\"hierarchy xhtCellBorder1 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vline.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon-q-coding.png\" alt=\"\" style=\"background-color: white; background-color: inherit\" title=\"coding\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">AHIP-DEMOGRAPHIC-QUESTIONNAIRE / RAE / </span>RAE1.2-HOL</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Please tell us your background. Check all that apply</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">1..*</td><td style=\"\" class=\"hierarchy xhtCellBorder1\"><a href=\"https://hl7.org/fhir/R4/codesystem-item-type.html#item-type-open-choice\">open-choice</a></td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Enable When: <span><a href=\"#item.RAE-1.1\">RAE-1.1</a> = Other Race (CDC Race and Ethnicity#2131-1)</span><br/>Value Set: <a href=\"ValueSet-ahip-background-latino-category.html\">AHIP Hispanic Latino Background Categories</a></td></tr>#xD;\n<tr class=\"xhtRowBorder1 xhtRowOdd\"><td style=\"background-image: url(tbl_bck110.png)\" id=\"item.RAE1.2-MEONA\" class=\"hierarchy xhtCellBorder1 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vline.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon-q-coding.png\" alt=\"\" style=\"background-color: #F7F7F7; background-color: inherit\" title=\"coding\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">AHIP-DEMOGRAPHIC-QUESTIONNAIRE / RAE / </span>RAE1.2-MEONA</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Please tell us your background. Check all that apply</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">1..*</td><td style=\"\" class=\"hierarchy xhtCellBorder1\"><a href=\"https://hl7.org/fhir/R4/codesystem-item-type.html#item-type-open-choice\">open-choice</a></td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Enable When: <span><a href=\"#item.RAE-1.1\">RAE-1.1</a> = Middle Eastern or North African (CDC Race and Ethnicity#2118-8)</span><br/>Value Set: <a href=\"ValueSet-ahip-background-middle-eastern-category.html\">AHIP Middle Eastern Background Categories</a></td></tr>#xD;\n<tr class=\"xhtRowBorder1 xhtRowEven\"><td style=\"background-image: url(tbl_bck110.png)\" id=\"item.RAE-1.2-NHOPI\" class=\"hierarchy xhtCellBorder1 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vline.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon-q-coding.png\" alt=\"\" style=\"background-color: white; background-color: inherit\" title=\"coding\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">AHIP-DEMOGRAPHIC-QUESTIONNAIRE / RAE / </span>RAE-1.2-NHOPI</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Please tell us your background. Check all that apply</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">1..*</td><td style=\"\" class=\"hierarchy xhtCellBorder1\"><a href=\"https://hl7.org/fhir/R4/codesystem-item-type.html#item-type-open-choice\">open-choice</a></td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Enable When: <span><a href=\"#item.RAE-1.1\">RAE-1.1</a> = Native Hawaiian or Other Pacific Islander (CDC Race and Ethnicity#2076-8)</span><br/>Value Set: <a href=\"ValueSet-ahip-background-native-hawaiian-category.html\">AHIP Native Hawaiian Background Categories</a></td></tr>#xD;\n<tr class=\"xhtRowBorder1 xhtRowOdd\"><td style=\"background-image: url(tbl_bck110.png)\" id=\"item.RAE1.2-W\" class=\"hierarchy xhtCellBorder1 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vline.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon-q-coding.png\" alt=\"\" style=\"background-color: #F7F7F7; background-color: inherit\" title=\"coding\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">AHIP-DEMOGRAPHIC-QUESTIONNAIRE / RAE / </span>RAE1.2-W</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Please tell us your background. Check all that apply</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">1..*</td><td style=\"\" class=\"hierarchy xhtCellBorder1\"><a href=\"https://hl7.org/fhir/R4/codesystem-item-type.html#item-type-open-choice\">open-choice</a></td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Enable When: <span><a href=\"#item.RAE-1.1\">RAE-1.1</a> = White (CDC Race and Ethnicity#2106-3)</span><br/>Value Set: <a href=\"ValueSet-ahip-background-white-category.html\">AHIP White Background Categories</a></td></tr>#xD;\n<tr class=\"xhtRowBorder1 xhtRowEven\"><td style=\"background-image: url(tbl_bck100.png)\" id=\"item.RAE1.3\" class=\"hierarchy xhtCellBorder1 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vline.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin_end.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon-q-text.png\" alt=\"\" style=\"background-color: white; background-color: inherit\" title=\"text\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">AHIP-DEMOGRAPHIC-QUESTIONNAIRE / RAE / </span>RAE1.3</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Are there things about your culture or cultural identity that you would like us to know?</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">0..1</td><td style=\"\" class=\"hierarchy xhtCellBorder1\"><a href=\"https://hl7.org/fhir/R4/codesystem-item-type.html#item-type-text\">text</a></td><td style=\"\" class=\"hierarchy xhtCellBorder1\"/></tr>#xD;\n<tr class=\"xhtRowBorder1 xhtRowOdd\"><td style=\"background-image: url(tbl_bck11.png)\" id=\"item.L\" class=\"hierarchy xhtCellBorder1 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon-q-group.png\" alt=\"\" style=\"background-color: #F7F7F7; background-color: inherit\" title=\"group\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">AHIP-DEMOGRAPHIC-QUESTIONNAIRE / </span>L</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Language Section</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">1..1</td><td style=\"\" class=\"hierarchy xhtCellBorder1\"><a href=\"https://hl7.org/fhir/R4/codesystem-item-type.html#item-type-group\">group</a></td><td style=\"\" class=\"hierarchy xhtCellBorder1\"/></tr>#xD;\n<tr class=\"xhtRowBorder1 xhtRowEven\"><td style=\"background-image: url(tbl_bck110.png)\" id=\"item.L-2.1\" class=\"hierarchy xhtCellBorder1 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vline.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon-q-coding.png\" alt=\"\" style=\"background-color: white; background-color: inherit\" title=\"coding\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">AHIP-DEMOGRAPHIC-QUESTIONNAIRE / L / </span>L-2.1</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">In which language(s) do you feel most comfortable speaking about your health care? This can include a specific language and/or different types of sign language. (Granular options can be customized to local level.) Select all that apply</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">1..*</td><td style=\"\" class=\"hierarchy xhtCellBorder1\"><a href=\"https://hl7.org/fhir/R4/codesystem-item-type.html#item-type-open-choice\">open-choice</a></td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Value Set: <a href=\"ValueSet-ahip-speaking-language-prereferences.html\">AHIP Speaking Language Preferences</a></td></tr>#xD;\n<tr class=\"xhtRowBorder1 xhtRowOdd\"><td style=\"background-image: url(tbl_bck110.png)\" id=\"item.L-2.2\" class=\"hierarchy xhtCellBorder1 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vline.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon-q-coding.png\" alt=\"\" style=\"background-color: #F7F7F7; background-color: inherit\" title=\"coding\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">AHIP-DEMOGRAPHIC-QUESTIONNAIRE / L / </span>L-2.2</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">In which language(s) do you prefer to use when reading materials related to your health care? This can include a specific language, Braille, large print, or digital documents that can be spoken out loud. (Granular options can be customized to local level.) Select all that apply.​</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">1..*</td><td style=\"\" class=\"hierarchy xhtCellBorder1\"><a href=\"https://hl7.org/fhir/R4/codesystem-item-type.html#item-type-open-choice\">open-choice</a></td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Value Set: <a href=\"ValueSet-ahip-reading-language-prereferences.html\">AHIP Reading Language Preferences</a></td></tr>#xD;\n<tr class=\"xhtRowBorder1 xhtRowEven\"><td style=\"background-image: url(tbl_bck110.png)\" id=\"item.L-2.3\" class=\"hierarchy xhtCellBorder1 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vline.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon-q-coding.png\" alt=\"\" style=\"background-color: white; background-color: inherit\" title=\"coding\" class=\"hierarchy\"/> <span style=\"position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0\" class=\"sr-only\">AHIP-DEMOGRAPHIC-QUESTIONNAIRE / L / </span>L-2.3</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">If an interpreter in your preferred language were available right now, would you choose to use one for your health care visit?</td><td style=\"\" class=\"hierarchy xhtCellBorder1\">1..1</td><td style=\"\" class=\"hierarchy xhtCellBorder1\"><a href=\"https://hl7.org/fhir/R4/codesystem-item-type.html#item-type-open-choice\">open-choice</a></td><td style=\"\" class=\"hierarchy xhtCellBorder1\">Value Set: <a href=\"ValueSet-ahip-yes-no-no-response.html\">AHIP Yes, No, or No Response</a></td></tr>#xD;\n<tr class=\"xhtRowBorder1 xhtRowOdd\"><td style=\"background-image: url(tbl_bck110.png)\" id=\"item.L-2.4\" class=\"hierarchy xhtCellBorder1 xhtCellNoWrap\"><img src=\"tbl_spacer.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vline.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\"\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon-q-coding.png\" alt=\"\" style=\"background-color: #F7F7F7; background-