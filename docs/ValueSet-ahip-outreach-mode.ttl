# - resource -------------------------------------------------------------------

<http://ahip.org/demographics/ValueSet/ahip-outreach-mode> a fhir:ValueSet ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "ahip-outreach-mode"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "extensions" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ValueSet ahip-outreach-mode</b></p><a name=\"ahip-outreach-mode\"> </a><a name=\"hcahip-outreach-mode\"> </a><p>This value set includes codes based on the following rules:</p><ul><li>Include these codes as defined in <a href=\"http://terminology.hl7.org/7.3.0/CodeSystem-v3-ParticipationMode.html\"><code>http://terminology.hl7.org/CodeSystem/v3-ParticipationMode</code></a><span title=\"Version is not explicitly stated, which means it is fixed to 6.0.0, the version found through the package references\"> version ?6.0.0</span><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td><a href=\"http://terminology.hl7.org/7.3.0/CodeSystem-v3-ParticipationMode.html#v3-ParticipationMode-EMAILWRIT\">EMAILWRIT</a></td><td>Email</td><td>Participation by text or diagrams transmitted over an electronic mail system.</td></tr><tr><td><a href=\"http://terminology.hl7.org/7.3.0/CodeSystem-v3-ParticipationMode.html#v3-ParticipationMode-PHONE\">PHONE</a></td><td>Phone Call</td><td>Participation by voice communication where the voices of the communicating parties are transported over an electronic medium</td></tr><tr><td><a href=\"http://terminology.hl7.org/7.3.0/CodeSystem-v3-ParticipationMode.html#v3-ParticipationMode-MAILWRIT\">MAILWRIT</a></td><td>Mailed Letter</td><td>Participation by text or diagrams printed on paper transmitted physically (e.g. by courier service, postal service).</td></tr><tr><td><a href=\"http://terminology.hl7.org/7.3.0/CodeSystem-v3-ParticipationMode.html#v3-ParticipationMode-MSGWRIT\">MSGWRIT</a></td><td>Text Message</td><td>Participation by messaging typically from a mobile phone or mobile device through a cellular network or Internet. Includes secured or unsecured messaging transmission and includes online chat. Also includes submission of photos or other images.</td></tr></table></li><li>Include these codes as defined in <a href=\"CodeSystem-AHIP-Demo-Additional-NullFlavor.html\"><code>http://ahip.org/demographics/CodeSystem/AHIP-Demo-Additional-NullFlavor</code></a><span title=\"Version is not explicitly stated, which means it is fixed to the version provided in this specification\"> version ?0.1.0</span><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td><a href=\"CodeSystem-AHIP-Demo-Additional-NullFlavor.html#AHIP-Demo-Additional-NullFlavor-CNTR\">CNTR</a></td><td>I choose not to respond at this time</td><td>**Description:**This code is to represent explicitly that the patient has chosen not to respond to this question at this time</td></tr></table></li></ul></div>"
  ] ;
  fhir:ValueSet.url [ fhir:value "http://ahip.org/demographics/ValueSet/ahip-outreach-mode"] ;
