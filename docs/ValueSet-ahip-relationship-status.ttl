# - resource -------------------------------------------------------------------

<http://ahip.org/demographics/ValueSet/ahip-relationship-status> a fhir:ValueSet ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "ahip-relationship-status"] ; # 
  fhir:text [
     fhir:status [ fhir:v "extensions" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ValueSet ahip-relationship-status</b></p><a name=\"ahip-relationship-status\"> </a><a name=\"hcahip-relationship-status\"> </a><p>This value set includes codes based on the following rules:</p><ul><li>Include these codes as defined in <a href=\"http://terminology.hl7.org/6.2.0/CodeSystem-v3-MaritalStatus.html\"><code>http://terminology.hl7.org/CodeSystem/v3-MaritalStatus</code></a><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td><a href=\"http://terminology.hl7.org/6.2.0/CodeSystem-v3-MaritalStatus.html#v3-MaritalStatus-M\">M</a></td><td>Married</td><td>A current marriage contract is active</td></tr><tr><td><a href=\"http://terminology.hl7.org/6.2.0/CodeSystem-v3-MaritalStatus.html#v3-MaritalStatus-D\">D</a></td><td>Divorced</td><td>Marriage contract has been declared dissolved and inactive</td></tr><tr><td><a href=\"http://terminology.hl7.org/6.2.0/CodeSystem-v3-MaritalStatus.html#v3-MaritalStatus-L\">L</a></td><td>Separated</td><td/></tr><tr><td><a href=\"http://terminology.hl7.org/6.2.0/CodeSystem-v3-MaritalStatus.html#v3-MaritalStatus-W\">W</a></td><td>Widowed</td><td>The spouse has died</td></tr><tr><td><a href=\"http://terminology.hl7.org/6.2.0/CodeSystem-v3-MaritalStatus.html#v3-MaritalStatus-T\">T</a></td><td>In a registered domestic partnership</td><td>Person declares that a domestic partner relationship exists.</td></tr><tr><td><a href=\"http://terminology.hl7.org/6.2.0/CodeSystem-v3-MaritalStatus.html#v3-MaritalStatus-U\">U</a></td><td>Single</td><td>Currently not in a marriage contract.</td></tr></table></li><li>Include these codes as defined in <code>http://ahip.org/demographics/ImplementationGuide/ahip.demo/CodeSystem/ahip-demo-additional-relationship-status-codes</code><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td></tr><tr><td>DATI</td><td>Dating (non-committed relationship)</td></tr><tr><td>MONR</td><td>Monogamous Relationship (In a committed relationship with one person but not married</td></tr><tr><td>POLY</td><td>Polyamorous Relationship (In a committed relationship with more than one person)</td></tr></table></li><li>Include these codes as defined in <code>http://ahip.org/demographics/ImplementationGuide/ahip.demo/CodeSystem/AHIPDemoAdditionalNullFlavor</code><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td></tr><tr><td>PSIN</td><td>Please specify if not listed above</td></tr><tr><td>CNTR</td><td>I choose not to respond at this time</td></tr></table></li></ul></div>"^^rdf:XMLLiteral
  ] ; # 
  fhir:url [ fhir:v "http://ahip.org/demographics/ValueSet/ahip-relationship-status"^^xsd:anyURI] ; # 
  fhir:version [ fhir:v "0.1.0"] ; # 
  fhir:name [ fhir:v "AHIPRelationshipStatus"] ; # 
  fhir:title [ fhir:v "AHIP Relationship Status"] ; # 
  fhir:status [ fhir:v "draft"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:date [ fhir:v "2025-03-24T00:00:00-04:00"^^xsd:dateTime] ; # 
  fhir:publisher [ fhir:v "AHIP"] ; # 
  fhir:contact ( [
     fhir:name [ fhir:v "AHIP" ] ;
     fhir:telecom ( [
       fhir:system [ fhir:v "url" ] ;
       fhir:value [ fhir:v "http://ahip.org" ]
     ] )
  ] ) ; # 
  fhir:description [ fhir:v "Based on HL7 Marital Status Value Set"] ; # 
  fhir:copyright [ fhir:v "Used by permission of HL7 International, all rights reserved Creative Commons License"] ; # 
  fhir:compose [
     fhir:include ( [
       fhir:system [ fhir:v "http://terminology.hl7.org/CodeSystem/v3-MaritalStatus"^^xsd:anyURI ] ;
       fhir:concept ( [
         fhir:code [ fhir:v "M" ] ;
         fhir:display [ fhir:v "Married" ]
       ] [
         fhir:code [ fhir:v "D" ] ;
         fhir:display [ fhir:v "Divorced" ]
       ] [
         fhir:code [ fhir:v "L" ] ;
         fhir:display [ fhir:v "Separated" ]
       ] [
         fhir:code [ fhir:v "W" ] ;
         fhir:display [ fhir:v "Widowed" ]
       ] [
         fhir:code [ fhir:v "T" ] ;
         fhir:display [ fhir:v "In a registered domestic partnership" ]
       ] [
         fhir:code [ fhir:v "U" ] ;
         fhir:display [ fhir:v "Single" ]
       ] )
     ] [
       fhir:system [ fhir:v "http://ahip.org/demographics/ImplementationGuide/ahip.demo/CodeSystem/ahip-demo-additional-relationship-status-codes"^^xsd:anyURI ] ;
       fhir:concept ( [
         fhir:code [ fhir:v "DATI" ] ;
         fhir:display [ fhir:v "Dating (non-committed relationship)" ]
       ] [
         fhir:code [ fhir:v "MONR" ] ;
         fhir:display [ fhir:v "Monogamous Relationship (In a committed relationship with one person but not married" ]
       ] [
         fhir:code [ fhir:v "POLY" ] ;
         fhir:display [ fhir:v "Polyamorous Relationship (In a committed relationship with more than one person)" ]
       ] )
     ] [
       fhir:system [ fhir:v "http://ahip.org/demographics/ImplementationGuide/ahip.demo/CodeSystem/AHIPDemoAdditionalNullFlavor"^^xsd:anyURI ] ;
       fhir:concept ( [
         fhir:code [ fhir:v "PSIN" ] ;
         fhir:display [ fhir:v "Please specify if not listed above" ]
       ] [
         fhir:code [ fhir:v "CNTR" ] ;
         fhir:display [ fhir:v "I choose not to respond at this time" ]
       ] )
     ] )
  ] . # 

