# - resource -------------------------------------------------------------------

<http://ahip.org/demographics/ValueSet/ahip-demo-gender-identity> a fhir:ValueSet ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "ahip-demo-gender-identity"] ; # 
  fhir:text [
     fhir:status [ fhir:v "extensions" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ValueSet ahip-demo-gender-identity</b></p><a name=\"ahip-demo-gender-identity\"> </a><a name=\"hcahip-demo-gender-identity\"> </a><p>This value set includes codes based on the following rules:</p><ul><li>Include these codes as defined in <a href=\"http://hl7.org/fhir/R4/codesystem-gender-identity.html\"><code>http://hl7.org/fhir/gender-identity</code></a><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td><a href=\"http://hl7.org/fhir/R4/codesystem-gender-identity.html#gender-identity-male\">male</a></td><td>Man</td><td>the patient identifies as male</td></tr><tr><td><a href=\"http://hl7.org/fhir/R4/codesystem-gender-identity.html#gender-identity-female\">female</a></td><td>Woman</td><td>the patient identifies as female</td></tr><tr><td><a href=\"http://hl7.org/fhir/R4/codesystem-gender-identity.html#gender-identity-transgender-man\">transgender-man</a></td><td>Transgender Man</td><td/></tr><tr><td><a href=\"http://hl7.org/fhir/R4/codesystem-gender-identity.html#gender-identity-transgender-woman\">transgender-woman</a></td><td>Transgender Woman</td><td/></tr><tr><td><a href=\"http://hl7.org/fhir/R4/codesystem-gender-identity.html#gender-identity-non-binary\">non-binary</a></td><td>Non-Binary (neither exclusively male nor female)</td><td>the patient identifies with neither/both female and male</td></tr></table></li><li>Include these codes as defined in <code>http://ahip.org/demographics/ImplementationGuide/ahip.demo/CodeSystem/ahip-demo-additional-gender-codes</code><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td></tr><tr><td>#GF</td><td>Gender Fluid (non-fixed gender indentity that may change overtime)</td></tr><tr><td>TS</td><td>Two Spirit (a person who has both a masculine and feminine spirit, traditionally used in Native American/Alaskan Native communities)</td></tr></table></li><li>Include these codes as defined in <code>http://ahip.org/demographics/ImplementationGuide/ahip.demo/CodeSystem/AHIPDemoAdditionalNullFlavor</code><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td></tr><tr><td>PSIN</td><td>Please specify if not listed above</td></tr><tr><td>CNTR</td><td>I choose not to respond at this time</td></tr></table></li><li>Include these codes as defined in <a href=\"http://terminology.hl7.org/6.2.0/CodeSystem-v3-NullFlavor.html\"><code>http://terminology.hl7.org/CodeSystem/v3-NullFlavor</code></a><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td><a href=\"http://terminology.hl7.org/6.2.0/CodeSystem-v3-NullFlavor.html#v3-NullFlavor-ASKU\">ASKU</a></td><td>I don't know</td><td>Information was sought but not found (e.g., patient was asked but didn't know)</td></tr></table></li></ul></div>"^^rdf:XMLLiteral
  ] ; # 
  fhir:url [ fhir:v "http://ahip.org/demographics/ValueSet/ahip-demo-gender-identity"^^xsd:anyURI] ; # 
  fhir:version [ fhir:v "0.1.0"] ; # 
  fhir:name [ fhir:v "AHIPDemoGenderIdentityValueSet"] ; # 
  fhir:title [ fhir:v "AHIP Gender"] ; # 
  fhir:status [ fhir:v "draft"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:date [ fhir:v "2025-03-24T00:00:00-04:00"^^xsd:dateTime] ; # 
  fhir:publisher [ fhir:v "AHIP"] ; # 
  fhir:contact ( [
     fhir:name [ fhir:v "AHIP" ] ;
     fhir:telecom ( [
       fhir:system [ fhir:v "url" ] ;
       fhir:value [ fhir:v "http://ahip.org" ]
     ] )
  ] ) ; # 
  fhir:description [ fhir:v "Based on HL7 Gender-Identity"] ; # 
  fhir:copyright [ fhir:v "Used by permission of HL7 International, all rights reserved Creative Commons License"] ; # 
  fhir:compose [
     fhir:include ( [
       fhir:system [ fhir:v "http://hl7.org/fhir/gender-identity"^^xsd:anyURI ] ;
       fhir:concept ( [
         fhir:code [ fhir:v "male" ] ;
         fhir:display [ fhir:v "Man" ]
       ] [
         fhir:code [ fhir:v "female" ] ;
         fhir:display [ fhir:v "Woman" ]
       ] [
         fhir:code [ fhir:v "transgender-man" ] ;
         fhir:display [ fhir:v "Transgender Man" ]
       ] [
         fhir:code [ fhir:v "transgender-woman" ] ;
         fhir:display [ fhir:v "Transgender Woman" ]
       ] [
         fhir:code [ fhir:v "non-binary" ] ;
         fhir:display [ fhir:v "Non-Binary (neither exclusively male nor female)" ]
       ] )
     ] [
       fhir:system [ fhir:v "http://ahip.org/demographics/ImplementationGuide/ahip.demo/CodeSystem/ahip-demo-additional-gender-codes"^^xsd:anyURI ] ;
       fhir:concept ( [
         fhir:code [ fhir:v "#GF" ] ;
         fhir:display [ fhir:v "Gender Fluid (non-fixed gender indentity that may change overtime)" ]
       ] [
         fhir:code [ fhir:v "TS" ] ;
         fhir:display [ fhir:v "Two Spirit (a person who has both a masculine and feminine spirit, traditionally used in Native American/Alaskan Native communities)" ]
       ] )
     ] [
       fhir:system [ fhir:v "http://ahip.org/demographics/ImplementationGuide/ahip.demo/CodeSystem/AHIPDemoAdditionalNullFlavor"^^xsd:anyURI ] ;
       fhir:concept ( [
         fhir:code [ fhir:v "PSIN" ] ;
         fhir:display [ fhir:v "Please specify if not listed above" ]
       ] [
         fhir:code [ fhir:v "CNTR" ] ;
         fhir:display [ fhir:v "I choose not to respond at this time" ]
       ] )
     ] [
       fhir:system [ fhir:v "http://terminology.hl7.org/CodeSystem/v3-NullFlavor"^^xsd:anyURI ] ;
       fhir:concept ( [
         fhir:code [ fhir:v "ASKU" ] ;
         fhir:display [ fhir:v "I don't know" ]
       ] )
     ] )
  ] . # 

